# ── Mobiele app (publiek, alleen publishable key — NOOIT service/secret keys hier) ──
EXPO_PUBLIC_SUPABASE_URL=https://gdjargpxcdgciusycyya.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Excel import script (LOKAAL / CI only, nooit in de app of in Git-commits) ──
# Import-sleutel met schrijfrechten hoort NIET in deze template: zet hem lokaal in .env.
# Welke variabele naam daarvoor nodig is, staat in INFISICAL.md.
SUPABASE_URL=https://gdjargpxcdgciusycyya.supabase.co

# ── Archil-disk (server-side, alleen voor scripts/ — nooit in de app) ──
# Server-side API-sleutel uit de Archil-console; regio moet gelijk zijn aan die van de disk.
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1
# Disk-id die scripts/archil-storage.mjs gebruikt; leeg = de check maakt er één aan.
ARCHIL_DISK_ID=

# ── Edge Functions (server-side secrets; zet via: supabase secrets set ...) ──
# AI provider (OpenAI-compatibel). Gratis optie: Groq Cloud (1000 req/dag op openai/gpt-oss-120b).
AI_API_BASE=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
# optioneel: apart vision-model voor factuurherkenning (scan-invoice), leeg = AI_MODEL
AI_VISION_MODEL=
# optioneel: daily budget guard voor AI-requests (max requests per user per dag)
AI_DAILY_USER_LIMIT=60
# Secret die Supabase Cron meesturet naar Edge Functions (verzin een sterk wachtwoord)
CRON_SECRET=
# optioneel: Expo push access token (Expo push werkt ook zonder token)
EXPO_ACCESS_TOKEN=
