{
  "name": "fix50",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "infisical run --env=dev -- expo start",
    "postinstall": "patch-package --error-on-fail",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "import:diagnosis": "tsx scripts/import-diagnosis.ts",
    "import:diagnosis:sql": "tsx scripts/import-diagnosis.ts --sql > supabase/seed/diagnosis_seed.sql",
    "pdf:brand": "node scripts/gen-pdf-brand.mjs",
    "pdf:preview": "tsx scripts/pdf-preview.ts",
    "desktop:export": "expo export --platform web --output-dir desktop/www",
    "desktop:build": "npm run desktop:export && electron-builder --win portable --config electron-builder.desktop.json"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@supabase/supabase-js": "^2.117.1",
    "expo": "~57.0.27",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "58.0.14",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^57.0.13",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "expo-device": "^57.0.2",
    "expo-modules-core": "^57.0.19",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "patch-package": "^6.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "xlsx": "^0.18.5"
  },
  "private": true
}
